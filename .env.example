# Shared CDASH Supabase project. Server-side only: this URL is read by the API
# routes, never by browser code, so it deliberately has no NEXT_PUBLIC_ prefix.
SUPABASE_URL=

# Server-side only. Never expose this in NEXT_PUBLIC_* or browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Used to sign the HTTP-only registered-member access cookie. If omitted, the
# server falls back to SUPABASE_SERVICE_ROLE_KEY.
MEMBER_GATE_SECRET=

# Optional public app URL used in WhatsApp/payment links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# CDASH Store API — the store's only line into money, stock and rewards.
# Server-to-server. The key reads any member's programme standing, so it must
# never reach a browser: no NEXT_PUBLIC_ prefix, never passed through to a page.
# Rotating it breaks the store's calls immediately, so coordinate with CDASH.
CDASH_API_URL=
CDASH_STORE_API_KEY=

# FALLBACK ONLY. The fulfilment store now lives in the online_store_settings
# table so directors can change it from the dashboard without a redeploy; this
# is read only when that row is missing or unreadable. Use a CDASH stores.id.
# DLC MID = 6870ffe3-59cf-4a8a-921e-012285b38f7e
# DLC HAT = a9c97a0a-72a6-4e78-999d-5b7682282d96
DEFAULT_STORE_ID=

# Optional. Column name for the unique member identifier in the CDASH `members`
# table. Defaults to member_id; the CDASH Prisma migration calls it
# member_number. Set this if member lookup or registration reports a missing
# column.
CDASH_MEMBER_ID_COLUMN=

# Authorises POST /api/catalog/sync, which rebuilds online_products from CDASH
# inventory. A database trigger already syncs on every stock movement, so this
# is only needed for a first seed or a scheduled safety net. Unset = endpoint
# fails closed (503).
CATALOG_SYNC_TOKEN=

# Where to send "new registration awaiting approval" notifications. Any endpoint
# that accepts a JSON POST — a WhatsApp Cloud API relay, a Slack incoming
# webhook, an internal service. Left blank, these events are logged to the
# server console instead.
STAFF_NOTIFY_WEBHOOK_URL=
STAFF_NOTIFY_WEBHOOK_TOKEN=
