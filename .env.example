# Shared CDASH Supabase project
NEXT_PUBLIC_SUPABASE_URL=

# Server-side only. Never expose this in NEXT_PUBLIC_* or browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Used to sign the HTTP-only registered-member access cookie. If omitted, the
# server falls back to SUPABASE_SERVICE_ROLE_KEY.
MEMBER_GATE_SECRET=

# Optional public app URL used in WhatsApp/payment links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required before enabling payment webhooks.
PAYMENT_WEBHOOK_SECRET=

# Default fulfilment store. Use a CDASH stores.id UUID.
DEFAULT_STORE_ID=

# Optional. Column name for the unique member identifier in the CDASH `members`
# table. Defaults to member_id; the CDASH Prisma migration calls it
# member_number. Set this if member lookup or registration reports a missing
# column.
CDASH_MEMBER_ID_COLUMN=

# Where to send "new registration awaiting approval" notifications. Any endpoint
# that accepts a JSON POST — a WhatsApp Cloud API relay, a Slack incoming
# webhook, an internal service. Left blank, these events are logged to the
# server console instead.
STAFF_NOTIFY_WEBHOOK_URL=
STAFF_NOTIFY_WEBHOOK_TOKEN=
